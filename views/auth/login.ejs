<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>

            <main>
                <% if (errorMessage) { %>
                    <div class="user-message user-message--error">
                        <%= errorMessage %>
                    </div>
                    <% } %>
                        <form class="login-form" action="/login" method="POST" novalidate>
                            <div class="auth-header" style="text-align: center; margin-bottom: 2rem;">
                                <svg width="140" height="32" viewBox="0 0 140 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin: 0 auto;">
                                    <circle cx="16" cy="16" r="14" stroke="#111827" stroke-width="2.5" stroke-opacity="0.1"/>
                                    <path d="M16 2C23.732 2 30 8.26801 30 16C30 19.5 28.2 22.5 25.5 24.5" stroke="#7C83FD" stroke-width="2.5" stroke-linecap="round"/>
                                    <path d="M12 12C12 9.5 13.8 7.5 16 7.5C18.2 7.5 20 9.5 20 12C20 14.5 12 15.5 12 18.5C12 21 13.8 23 16 23C18.2 23 20 21 20 18.5" stroke="#7C83FD" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M48 10C48 8.5 49 7.5 50.5 7.5H53.5C55 7.5 56 8.5 56 10C56 12 48 12.5 48 15C48 16.5 49 17.5 50.5 17.5H53.5C55 17.5 56 16.5 56 15" stroke="#111827" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <text x="60" y="21" fill="#111827" font-family="'Plus Jakarta Sans', sans-serif" font-weight="800" font-size="14.5" letter-spacing="-0.3px">hop<tspan fill="#7C83FD">Sphere</tspan></text>
                                </svg>
                            </div>
                            <div class="form-control">
                                <label for="email">E-Mail</label>
                                <input 
                                class = "<%= validationErrors.find(e => e.path === 'email') ? 'invalid' : '' %>"
                                type="email" 
                                name="email" 
                                id="email" 
                                value="<%=oldInput.email%>">
                            </div>
                            <div class="form-control">
                                <label for="password">Password</label>
                                <input 
                                class = "<%= validationErrors.find(e => e.path === 'password') ? 'invalid' : '' %>"
                                type="password" 
                                name="password" 
                                id="password" 
                                value="<%= oldInput.password %>">
                            </div>
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button class="btn btn--primary" type="submit">Login</button>
                        </form>
                        <div class="centered">
                            <a href="/reset">Reset password</a>
                        </div>
            </main>
            <%- include('../includes/end.ejs') %>