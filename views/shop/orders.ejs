<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/orders.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <div class="orders-header">
                    <h1>My Orders</h1>
                    <p>View your previous purchases and invoices.</p>
                </div>

                <% if (orders.length <= 0) { %>
                    <div class="empty-state">
                        <div class="empty-state__icon">📦</div>
                        <h2>No Orders Found</h2>
                        <p>You haven't placed any orders yet. Start shopping to fill this page with your verified order transactions and downloadable invoices.</p>
                        <a href="/" class="btn">Start Shopping</a>
                    </div>
                <% } else { %>
                    <div class="orders-container">
                        <ul class="orders-list">
                            <% orders.forEach(order => { %>
                                <li class="order-card">
                                    <!-- Order Card Header -->
                                    <div class="order-card__header">
                                        <div class="order-card__meta">
                                            <span class="order-card__label">Order ID</span>
                                            <h3 class="order-card__id">#<%= order._id %></h3>
                                        </div>
                                        <a href="/orders/<%= order._id %>" class="btn btn--secondary-outline order-card__invoice-btn">Invoice</a>
                                    </div>
                                    <div class="order-card__divider"></div>
                                    <!-- Order Card Body -->
                                    <div class="order-card__body">
                                        <h4 class="order-card__subtitle">Items</h4>
                                        <ul class="order-card__products">
                                            <% order.products.forEach(p => { %>
                                                <li class="order-card__product-row">
                                                    <span class="product-title"><%= p.product.title %></span>
                                                    <span class="product-qty">× <%= p.quantity %></span>
                                                </li>
                                            <% }); %>
                                        </ul>
                                    </div>
                                </li>
                            <% }); %>
                        </ul>
                    </div>
                <% } %>
            </main>
            <%- include('../includes/end.ejs') %>