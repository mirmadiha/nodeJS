<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/orders.css">
    </head>

    <body>
        <%- include('../includes/navigation.ejs') %>
            <main>
                <% if (orders.length <=0) { %>
                    <div class="empty-state">
                        <div class="empty-state__icon">📦</div>
                        <h2>No Orders Found</h2>
                        <p>You haven't placed any orders yet. Start shopping to fill this page with your verified order transactions and downloadable invoices.</p>
                        <a href="/" class="btn">Start Shopping</a>
                    </div>
                    <% } else { %>
                        <ul class="orders">
                            <% orders.forEach(order=> { %>
                                <li class="orders__item">
                                    <h1>Order - # <%= order._id %> - <a href="/orders/<%=order._id%>">Invoice</a>
                                    </h1>
                                    <ul class="orders__products">
                                        <% order.products.forEach(p=> { %>
                                            <li class="orders__products-item">
                                                <%= p.product.title %> (<%= p.quantity %>)
                                            </li>
                                            <% }); %>
                                    </ul>
                                </li>
                                <% }); %>
                        </ul>
                        <% } %>
            </main>
            <%- include('../includes/end.ejs') %>